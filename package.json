{
  "name": "viskool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": [
    "Chrome >= 100",
    "Edge >= 100",
    "Firefox >= 100",
    "Safari >= 16",
    "iOS >= 16"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true}); console.log('removed .next')\"",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/print-e2e-hints.mjs",
    "start": "next start",
    "build:dev": "next build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:content": "tsx scripts/seed-content.ts",
    "clear:content": "tsx scripts/clear-content.ts",
    "db:dump": "tsx scripts/dump-archive.ts",
    "db:restore": "tsx scripts/restore-archive.ts",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.mongo.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.mongo.yml down",
    "docker:logs": "docker compose -f docker-compose.yml -f docker-compose.mongo.yml logs -f app",
    "test:e2e": "npm run test:e2e:all",
    "test:e2e:all": "npm run test:e2e:prepare && playwright test",
    "test:e2e:prepare": "tsx scripts/e2e-seed-admin.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test e2e/tests/smoke",
    "test:e2e:auth": "playwright test e2e/tests/auth",
    "test:e2e:admin": "playwright test e2e/tests/admin e2e/tests/cms",
    "test:e2e:report": "playwright show-report",
    "test:e2e:help": "node scripts/print-e2e-hints.mjs",
    "test:e2e:install": "playwright install chromium",
    "test:unit": "tsx --test src/lib/blog-link-sanitize.test.ts src/lib/blog-post-draft.test.ts src/lib/blog-post-admin-lookup.test.ts src/lib/blog-content-doc.test.ts src/lib/course-detail.test.ts src/lib/course-section-heading.test.ts src/lib/course-detail-cms-draft.test.ts src/lib/course-detail-cms.test.ts src/lib/course-detail-dirty-key.test.ts src/lib/json-ld.test.ts src/lib/announcement-banner.test.ts src/lib/wayvida-url.test.ts src/lib/form-field-validation.test.ts src/lib/cms-chart/schema.test.ts src/lib/cms-chart/ticks.test.ts src/lib/cms-chart/beside-text.test.ts src/lib/cms-rich-text-validation.test.ts src/lib/rte-text-case.test.ts src/lib/course-menu-tree.test.ts src/components/cms/pages/founderCmsData.test.ts",
    "precommit": "lint-staged && node scripts/precommit-check.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@azure/storage-blob": "^12.31.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
